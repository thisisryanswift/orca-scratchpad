#!/usr/bin/env bash
# Find (and optionally add to) this workspace's Orca Scratchpad list.
#   scratch            print the list file's path for the current workspace
#   scratch show       print the list
#   scratch add TEXT   append "- [ ] TEXT"
# The naming rules match src/paths.ts in the Scratchpad plugin: <folder>/<host>/<name>.md, where
# <name> is "folder-<id>" for a folder workspace (bots), else the workspace path after
# /home/<user>/ (or /Users/<user>/) with "/" turned into "--".
set -euo pipefail

folder="${ORCA_SCRATCH_DIR:-$HOME/Sync/orca-scratch}"
host="$(hostname -s 2>/dev/null || hostname)"
host="${host%%.*}"
host="$(printf '%s' "$host" | sed 's/[^A-Za-z0-9_-]/_/g')"

# Inside an Orca agent session, ask Orca which workspace this session belongs to.
workspace_id=""
if [ -n "${ORCA_AGENT_SESSION_ID:-}" ]; then
  orca_cli="${ORCA_CLI_COMMAND:-$(command -v orca-ide || true)}"
  if [ -n "$orca_cli" ] && [ -x "$orca_cli" ]; then
    workspace_id="$("$orca_cli" agent show "$ORCA_AGENT_SESSION_ID" --json 2>/dev/null |
      sed -n 's/.*"worktreeId": *"\([^"]*\)".*/\1/p' | head -n 1 || true)"
  fi
fi

slug_path() {
  local root="${1%/}" rest
  if [[ "$root" =~ ^/(home|Users)/[^/]+/?(.*)$ ]]; then rest="${BASH_REMATCH[2]}"; else rest="${root#/}"; fi
  rest="$(printf '%s' "$rest" | tr -s '/' | sed 's#^/##; s#/$##; s#/#--#g; s/[^A-Za-z0-9._-]/_/g')"
  printf '%s' "${rest:-_home}"
}

case "$workspace_id" in
  folder:*) slug="folder-$(printf '%s' "${workspace_id#folder:}" | sed 's/[^A-Za-z0-9-]/_/g')" ;;
  *::/*) slug="$(slug_path "${workspace_id#*::}")" ;;
  *) slug="$(slug_path "$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)")" ;;
esac
file="$folder/$host/$slug.md"

case "${1:-path}" in
  path) printf '%s\n' "$file" ;;
  show) [ -f "$file" ] && cat "$file" || echo "(empty: $file)" ;;
  add)
    shift
    [ $# -gt 0 ] || { echo "usage: scratch add TEXT" >&2; exit 2; }
    mkdir -p "$(dirname "$file")"
    printf -- '- [ ] %s\n' "$*" >>"$file"
    ;;
  *) echo "usage: scratch [path|show|add TEXT]" >&2; exit 2 ;;
esac
